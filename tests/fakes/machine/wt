#!/usr/bin/env bash
# 假的 wt（流程沙箱 3-12 用，安装脚本 install/wt.sh 把它放到 $SOP_TOOLS/wt/wt）。只会 --version 和 doctor。
# doctor 照真 wt 的样子只查环境那一节（不在项目里）：gh 登录了没有（用 PATH 里的 gh，也就是规定位置那份假 gh）、
# Git 的提交身份设了没有（M3 设的）；剧本目录 $FAKE_SETUP_DIR 里有 wt-doctor-fail 时多报一项失败，内容是那个文件的文字。
# 每跑一次 doctor 往 $FAKE_SETUP_DIR/wt.log 记一行。
case "${1:-}" in
  --version) echo "wt 1.3.1 (假的)"; exit 0 ;;
  doctor) ;;
  *) echo "假的 wt 只会 --version、doctor" >&2; exit 2 ;;
esac
[ -n "${FAKE_SETUP_DIR:-}" ] && echo doctor >> "$FAKE_SETUP_DIR/wt.log"
fail=0
echo "── 环境"
echo "  ✔ bash ${BASH_VERSION}"
if gh auth status --hostname github.com >/dev/null 2>&1; then
  echo "  ✔ gh 已登录"
else
  echo "  ✖ gh 没登录 GitHub"; fail=$((fail + 1))
fi
if [ -n "$(git config --global user.name)" ] && [ -n "$(git config --global user.email)" ]; then
  echo "  ✔ Git 提交身份"
else
  echo "  ✖ Git 提交身份没设"; fail=$((fail + 1))
fi
if [ -n "${FAKE_SETUP_DIR:-}" ] && [ -e "$FAKE_SETUP_DIR/wt-doctor-fail" ]; then
  echo "  ✖ $(cat "$FAKE_SETUP_DIR/wt-doctor-fail")"; fail=$((fail + 1))
fi
echo "  ⚠ 全局配置缺少 pull.ff（假的提醒）"
if [ "$fail" -gt 0 ]; then
  echo "wt: ✖ $fail 项失败"
  exit 1
fi
echo "wt: 环境没问题"
