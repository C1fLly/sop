def auth_cmd(args):
    """登录状态那几条命令（auth.json 存在时）。不是这几条返回 None，接着往下走。"""
    with open(AUTH) as f:
        a = json.load(f)

    def save():
        tmp = AUTH + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(a, f, ensure_ascii=False, indent=1)
        os.replace(tmp, AUTH)

    def scopes_opt():
        v = opt(args, '--scopes') or opt(args, '-s') or ''
        return [x for x in v.split(',') if x]

    cmd = args[:2]
    if cmd[:1] in (['auth'], ['ssh-key']):
        a.setdefault('calls', []).append(args)
        save()
    if cmd == ['auth', 'status']:
        if not a.get('logged_in'):
            print('You are not logged into any GitHub hosts. To log in, run: gh auth login', file=sys.stderr); return 1
        sc = ', '.join(f"'{x}'" for x in sorted(a.get('scopes', [])))
        print(f'github.com\n  ✓ Logged in to github.com account {LOGIN} (keyring)\n  - Active account: true\n'
              f'  - Git operations protocol: {a.get("protocol", "https")}\n  - Token: gho_************************************\n'
              f'  - Token scopes: {sc}')
        return 0
    if cmd == ['auth', 'login']:
        if '--web' not in args and '-w' not in args:
            print('fake gh: 只会网页登录', file=sys.stderr); return 2
        if os.environ.get('FAKEGH_LOGIN_FAIL'):
            print('error: authentication cancelled', file=sys.stderr); return 1
        print('! First copy your one-time code: FAKE-CODE', file=sys.stderr)
        a.update(logged_in=True, scopes=sorted(set(MIN_SCOPES + scopes_opt())), protocol=opt(args, '--git-protocol') or opt(args, '-p') or 'https')
        save()
        print(f'✓ Logged in as {LOGIN}', file=sys.stderr); return 0
    if cmd == ['auth', 'refresh']:
        if not a.get('logged_in'):
            print('not logged in to any hosts', file=sys.stderr); return 1
        a['scopes'] = sorted(set(a.get('scopes', []) + scopes_opt()))
        save()
        print('✓ Authentication complete.', file=sys.stderr); return 0
    if cmd == ['auth', 'token']:
        if not a.get('logged_in') or not a.get('token'):
            print('no oauth token found for github.com', file=sys.stderr); return 1
        print(a['token']); return 0
    if not a.get('logged_in') and args[:1] in (['api'], ['ssh-key'], ['repo'], ['pr'], ['issue']):
        print('To get started with GitHub CLI, please run:  gh auth login', file=sys.stderr); return 4
    if args[:1] == ['api'] and api_parse(args, read_body=False)[1] == 'meta':
        out({'ssh_keys': HOST_KEYS, 'verifiable_password_authentication': False}, args); return 0
    if cmd == ['ssh-key', 'add']:
        if 'admin:public_key' not in a.get('scopes', []):
            print('HTTP 404: Not Found (https://api.github.com/user/keys)\n'
                  'This API operation needs the "admin:public_key" scope. To request it, run:  gh auth refresh -h github.com -s admin:public_key',
                  file=sys.stderr); return 1
        key = ' '.join(open(args[2]).read().split()[:2])
        if key in a.setdefault('ssh_keys', []):
            print('✓ Public key already exists on your account', file=sys.stderr); return 0
        a['ssh_keys'].append(key)
        save()
        print('✓ Public key added to your account', file=sys.stderr); return 0
    return None
def issue_cmd(args):
    """issue create / issue list（3-42）。"""
    f = os.path.join(HOME, 'issues.json')
    issues = json.load(open(f)) if os.path.exists(f) else []
    repo = opt(args, '--repo') or opt(args, '-R') or os.environ.get('GH_REPO')
    if not repo:
        print('fake gh: 要 --repo', file=sys.stderr); return 1
    if args[:2] == ['issue', 'list']:
        out([i for i in issues if i['repo'] == repo], args); return 0
    if args[:2] != ['issue', 'create']:
        print(f'fake gh: 不认识的命令 {" ".join(args)}', file=sys.stderr); return 1
    title = opt(args, '--title') or opt(args, '-t')
    bf = opt(args, '--body-file') or opt(args, '-F')
    body = opt(args, '--body') or opt(args, '-b')
    if bf is not None:
        body = sys.stdin.read() if bf == '-' else open(bf, encoding='utf-8').read()
    if not title or body is None:
        print('must provide `--title` and `--body` (or `--fill` or `--web`) when not running interactively', file=sys.stderr); return 1
    if len(body) > 65536:
        print('GraphQL: Body is too long (maximum is 65536 characters) (createIssue)', file=sys.stderr); return 1
    n = len([i for i in issues if i['repo'] == repo]) + 1
    issues.append({'repo': repo, 'number': n, 'title': title, 'body': body, 'url': f'https://github.com/{repo}/issues/{n}'})
    tmp = f + '.tmp'
    with open(tmp, 'w') as fh:
        json.dump(issues, fh, ensure_ascii=False, indent=1)
    os.replace(tmp, f)
    print(f'\nCreating issue in {repo}\n', file=sys.stderr)
    print(f'https://github.com/{repo}/issues/{n}'); return 0


VALUE_OPTS = ('-X', '--method', '-F', '--field', '-f', '--raw-field', '--input', '--jq', '-q', '-H', '--header', '--json')


def api_parse(args, read_body=True):
    """gh api 的参数：(方法, 路径, 字段, 请求体)。-F 的值按 gh 的规矩转成 true/false/数字。read_body=False 时不读请求体（只看路径）。"""
    method, path, fields, body, i = None, None, {}, None, 1
    while i < len(args):
        a = args[i]
        if a in VALUE_OPTS:
            v = args[i + 1]
            if a in ('-X', '--method'):
                method = v.upper()
            elif a in ('-F', '--field', '-f', '--raw-field'):
                k, _, val = v.partition('=')
                if a in ('-F', '--field'):
                    val = {'true': True, 'false': False}.get(val, int(val) if val.isdigit() else val)
                fields[k] = val
            elif a == '--input' and read_body:
                body = json.load(sys.stdin if v == '-' else open(v, encoding='utf-8'))
            i += 2
            continue
        if path is None and not a.startswith('-'):
            path = a
        i += 1
    path = (path or '').lstrip('/')
    has_body = '--input' in args
    return method or ('POST' if fields or has_body else 'GET'), path, fields, body


def fail_http(code, msg):
    print(f'gh: {msg} (HTTP {code})', file=sys.stderr)
    return 1


def repo_obj(s):
    return {'name': s.d['slug'].split('/')[1], 'full_name': s.d['slug'], 'private': s.d['visibility'] == 'private',
            'visibility': s.d['visibility'], **s.d['settings']}


def protection_obj(s, b, p):
    o = {'url': f'https://api.github.com/repos/{s.d["slug"]}/branches/{b}/protection',
         'enforce_admins': {'enabled': p['enforce_admins']},
         'allow_force_pushes': {'enabled': p['allow_force_pushes']}, 'allow_deletions': {'enabled': p['allow_deletions']}}
    if p['contexts'] is not None:
        o['required_status_checks'] = {'strict': p['strict'], 'contexts': p['contexts'],
                                       'checks': [{'context': c, 'app_id': None} for c in p['contexts']]}
    if p['reviews'] is not None:
        o['required_pull_request_reviews'] = p['reviews']
    return o


def api_write(s, method, parts, fields, body, args):
    """仓库设置、分支保护、事件规则。"""
    if len(parts) == 3 and method == 'PATCH':                       # repos/<所有者>/<名>
        for k, v in fields.items():
            if k == 'allow_auto_merge' and s.d['visibility'] == 'private':
                continue          # GitHub 免费计划的私有仓库不支持自动合并：请求成功，这一项被忽略（wt 认这种情况）
            s.d['settings'][k] = v
        out(repo_obj(s), args); return 0
    if len(parts) >= 6 and parts[3] == 'branches' and parts[-1] == 'protection':
        b = '/'.join(parts[4:-1])
        if s.d['visibility'] == 'private':
            return fail_http(403, 'Upgrade to GitHub Pro or make this repository public to enable this feature.')
        prot = s.d.setdefault('protection', {})
        if method == 'GET':
            if b not in prot:
                return fail_http(404, 'Branch not protected')
            out(protection_obj(s, b, prot[b]), args); return 0
        if method == 'PUT':
            if not s.sha(b):
                return fail_http(404, 'Branch not found')
            body = body or {}
            for k in ('required_status_checks', 'enforce_admins', 'required_pull_request_reviews', 'restrictions'):
                if k not in body:
                    return fail_http(422, f'Invalid request. "{k}" wasn\'t supplied.')
            rsc = body['required_status_checks']
            ctx = None if rsc is None else list(rsc.get('contexts') or [c['context'] for c in rsc.get('checks', [])])
            prot[b] = {'contexts': ctx, 'strict': bool(rsc and rsc.get('strict')), 'enforce_admins': bool(body['enforce_admins']),
                       'reviews': body['required_pull_request_reviews'], 'allow_force_pushes': bool(body.get('allow_force_pushes')),
                       'allow_deletions': bool(body.get('allow_deletions'))}
            out(protection_obj(s, b, prot[b]), args); return 0
    if parts[3:5] == ['actions', 'policies']:
        pol = s.d.setdefault('policies', [])
        if method == 'GET':
            out({'total_count': len(pol), 'policies': pol}, args); return 0
        if method == 'POST':
            body = body or {}
            wp = (body.get('conditions') or {}).get('workflow_path') or {}
            if not isinstance(wp.get('include'), list) or not isinstance(wp.get('exclude'), list):
                return fail_http(422, 'Invalid request. conditions.workflow_path needs include and exclude')    # W40 第一次就是这样错的
            if body.get('enforcement') not in ('active', 'disabled'):
                return fail_http(422, 'Invalid request. enforcement must be active or disabled')   # 免费的没有 evaluate
            if any(p['name'] == body.get('name') for p in pol):
                return fail_http(422, 'Validation Failed: name already exists')
            p = {'id': 15000 + len(pol) + 1, 'name': body['name'], 'enforcement': body['enforcement'],
                 'conditions': {'workflow_path': {'include': wp['include'], 'exclude': wp['exclude']}}, 'rules': body.get('rules', [])}
            pol.append(p)
            out(p, args); return 0
    return fail_http(404, f'Not Found（fake gh 不认识 {method} {"/".join(parts)}）')


def repo_create(args):
    """gh repo create <所有者>/<名> --public|--private --add-readme：建远程，带一个 README 提交（和 GitHub 一样）。"""
    slug = args[0] if args and not args[0].startswith('-') else None
    if not slug or slug.count('/') != 1 or ('--public' in args) == ('--private' in args):
        print('fake gh: 用法 repo create <所有者>/<名> --public|--private --add-readme', file=sys.stderr); return 1
    if slug.split('/')[0] != LOGIN:
        print(f'GraphQL: {LOGIN} cannot create a repository for {slug.split("/")[0]}. (createRepository)', file=sys.stderr); return 1
    remote = os.path.join(HOME, 'repos', slug + '.git')
    git('init', '-q', '--bare', '-b', 'main', remote)
    if '--add-readme' in args:
        env = {**os.environ, 'GIT_AUTHOR_NAME': LOGIN, 'GIT_AUTHOR_EMAIL': 'noreply@github.invalid',
               'GIT_COMMITTER_NAME': 'GitHub', 'GIT_COMMITTER_EMAIL': 'noreply@github.invalid'}
        blob = subprocess.run(['git', '--git-dir', remote, 'hash-object', '-w', '--stdin'], input=f'# {slug.split("/")[1]}\n',
                              capture_output=True, text=True, check=True).stdout.strip()
        tree = subprocess.run(['git', '--git-dir', remote, 'mktree'], input=f'100644 blob {blob}\tREADME.md\n',
                              capture_output=True, text=True, check=True).stdout.strip()
        c = subprocess.run(['git', '--git-dir', remote, 'commit-tree', tree, '-m', 'Initial commit'], capture_output=True, text=True,
                           env=env, check=True).stdout.strip()
        git('--git-dir', remote, 'update-ref', 'refs/heads/main', c)
    init(HOME, remote, slug, 'public' if '--public' in args else 'private')
    d = json.load(open(DB))
    d.update({'checks': 'run', 'protection': {}, 'policies': [],
              'settings': {'allow_merge_commit': True, 'allow_squash_merge': True, 'allow_rebase_merge': True,
                           'allow_auto_merge': False, 'delete_branch_on_merge': False}})
    json.dump(d, open(DB, 'w'), ensure_ascii=False, indent=1)
    print(f'https://github.com/{slug}')
    return 0


def init(home, remote, slug, visibility):
    """建一个假的 GitHub 仓库的状态。"""
    os.makedirs(home, exist_ok=True)
    json.dump({'clock': 0, 'remote': str(remote), 'slug': slug, 'visibility': visibility, 'prs': {}, 'runs': [],
               'next_pr': 1, 'next_run': 1}, open(os.path.join(home, 'db.json'), 'w'), indent=1)


