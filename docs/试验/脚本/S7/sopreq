#!/usr/bin/env python3
"""窄接口的受限侧一头（S7 试验的最小实现）。

用法：sopreq new-worktree <工单编号|fix>    请特权侧为一张工单建工作目录，打印目录路径
      sopreq merged <工单编号|fix>          报告「我已把这张工单合入集成分支」，特权侧核对后推送
      sopreq done                           报告全部完成
受限侧只能往 requests/ 里放请求文件；真正的事由外面的特权侧去做。
"""
import json, os, sys, time, pathlib, secrets
root = pathlib.Path(__file__).resolve().parents[2]
req_dir = root / '.shared' / 'broker' / 'requests'; res_dir = root / '.shared' / 'broker' / 'responses'
a = sys.argv[1:]
if not a or a[0] not in ('new-worktree', 'merged', 'done') or (a[0] != 'done' and len(a) != 2):
    print(__doc__); sys.exit(2)
rid = f'{time.time_ns()}-{secrets.token_hex(3)}'
req = {'id': rid, 'kind': a[0], 'ticket': a[1] if len(a) > 1 else None, 'cwd': os.getcwd()}
tmp = req_dir / (rid + '.tmp'); tmp.write_text(json.dumps(req, ensure_ascii=False)); tmp.rename(req_dir / (rid + '.json'))
res = res_dir / (rid + '.json')
for _ in range(600):   # 最多等 5 分钟
    if res.exists():
        r = json.loads(res.read_text())
        print(r.get('message', ''))
        sys.exit(0 if r.get('ok') else 1)
    time.sleep(0.5)
print('特权侧 5 分钟没有回答'); sys.exit(1)
