#!/usr/bin/env python3
"""假的 claude（3-27 的单元测试用，不花钱）。只模仿适配器用到的那几样：--version、--help、-p ... --output-format json。
怎么表现由环境变量 ANTHROPIC_BASE_URL 定（适配器从 config/ai/claude.env 带进受限环境）：
  fake://ok       正常：回答一句，任务包里要写结果文件就写一份合格的
  fake://list     输出写成一串事件（有的版本是这样）
  fake://quota    服务报余额不足：会话日志里留一句，退出码 1
  fake://iserror  报错但退出码 0
  fake://garbage  输出不是 JSON
  fake://slow     睡 30 秒
  fake://leak     报错里带着密钥原文（看适配器会不会去掉）
  https://<上面几种>.fake.invalid 也一样（3-10：M4 只收 http(s) 开头的地址）
程序名里带 old 的，--help 里少了 --max-budget-usd（模仿升级后改了用法）。
每次 -p 调用在 $CLAUDE_CONFIG_DIR/projects/<工作目录改写>/<会话编号>.jsonl 留一行：收到的参数、环境变量的名字、状态目录里的设置。
密钥只认 fake- 开头的；别的值一律不记（万一真的密钥漏进来，也不往文件里写）。"""
import json
import os
import sys
import time
import uuid

argv = sys.argv[1:]
me = os.path.basename(sys.argv[0])
if argv[:1] == ['--version']:
    print('9.9.9 (Claude Code)')
    sys.exit(0)
if argv[:1] == ['--help']:
    flags = ['-p, --print', '--output-format <format>', '-r, --resume [value]', '--max-budget-usd <amount>',
             '--dangerously-skip-permissions']
    if 'old' in me:
        flags.remove('--max-budget-usd <amount>')
    print('Usage: claude [options]\n' + '\n'.join('  ' + f for f in flags))
    sys.exit(0)
if '-p' not in argv:
    print('假 claude 只会 -p', file=sys.stderr)
    sys.exit(2)
prompt = argv[argv.index('-p') + 1]
mode = os.environ.get('ANTHROPIC_BASE_URL', '').replace('fake://', '')
if '.fake.invalid' in mode:      # 3-10：M4 只收 http(s) 地址，https://<表现>.fake.invalid 也认
    mode = mode.split('://', 1)[-1].split('.', 1)[0]
tok = os.environ.get('ANTHROPIC_AUTH_TOKEN', '')
cfg = os.environ.get('CLAUDE_CONFIG_DIR', '')
sid = str(uuid.uuid4())
settings = None
try:
    settings = json.load(open(os.path.join(cfg, '.claude.json')))
except (OSError, ValueError):
    pass
logd = os.path.join(cfg, 'projects', os.getcwd().replace('/', '-'))
os.makedirs(logd, exist_ok=True)
rec = {'argv': argv, 'env_names': sorted(os.environ), 'token': tok if tok.startswith('fake-') else ('其他' if tok else ''),
       'home': os.environ.get('HOME'), 'cwd': os.getcwd(), 'settings': settings, 'prompt': prompt}
if mode == 'quota':
    rec['error'] = 'API Error: 403 {"error":{"type":"insufficient_balance","message":"insufficient balance"}}'
with open(os.path.join(logd, f'{sid}.jsonl'), 'a') as fh:
    fh.write(json.dumps(rec, ensure_ascii=False) + '\n')


def result(text, cost=0.0123, is_error=False, subtype='success'):
    return {'type': 'result', 'subtype': subtype, 'is_error': is_error, 'result': text, 'session_id': sid,
            'total_cost_usd': cost, 'num_turns': 1}


if mode == 'slow':
    time.sleep(30)
if mode == 'garbage':
    print('这不是 JSON')
    sys.exit(0)
if mode == 'quota':
    print(json.dumps(result('API Error: 403 insufficient balance', cost=0, is_error=True)))
    sys.exit(1)
if mode == 'iserror':
    print(json.dumps(result('', cost=0.001, is_error=True, subtype='error_during_execution')))
    sys.exit(0)
if mode == 'leak':
    print(f'连不上服务，用的密钥是 {tok}', file=sys.stderr)
    sys.exit(1)
if '/sop/out/result.json' in prompt and os.path.isdir('/sop/out'):
    with open('/sop/out/result.json', 'w') as fh:
        json.dump({'status': 'done', 'commits': [], 'commands': [], 'deviations': [], 'questions': [],
                   'findings': [{'text': '假的发现', 'blocking': False}]}, fh, ensure_ascii=False)
r = result('收到')
print(json.dumps([{'type': 'system', 'subtype': 'init'}, r] if mode == 'list' else r))
